# Non-secret config for the gather-0 project (project number 452707439741).
# Firebase loads this automatically when deploying/emulating gather-0.
# Secrets (client ID/secret, encryption key) live in Secret Manager — see src/params.js.

BRIGHTSPACE_BASE_URL=https://lmu.brightspace.com

# Must EXACTLY match the redirect URI registered on the Brightspace OAuth app.
BRIGHTSPACE_REDIRECT_URI=https://us-central1-gather-0.cloudfunctions.net/api/brightspace/callback

# Read-only scopes used by src/helpers/brightspaceApi.js.
BRIGHTSPACE_SCOPES=enrollment:own_enrollment:read calendar:my_events:read

# Where the callback sends the browser afterwards (/brightspace/success or /brightspace/error).
# Vite dev server default; change to the hosted frontend URL once it exists.
APP_URL=http://localhost:5173
