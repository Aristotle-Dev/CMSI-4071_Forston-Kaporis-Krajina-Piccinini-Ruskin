rules_version = '2';

// Gather Firestore security rules.
//
// All data access goes through the Cloud Functions API (Express), which
// uses the Admin SDK. The Admin SDK bypasses these rules, so the backend
// keeps full access. Users are checked by the `authenticate` middleware
// and requests are validated in the handlers.
//
// No client (web, mobile, or anyone holding the Firebase config) may read
// or write Firestore directly. This protects user data, the encrypted
// Brightspace tokens, and the audit logs from direct access.
//
// If the frontend ever needs direct access (e.g. real-time listeners),
// add a narrow read-only rule for that path, e.g.:
//   match /users/{uid}/assignments/{id} {
//     allow read: if request.auth != null && request.auth.uid == uid;
//   }

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
